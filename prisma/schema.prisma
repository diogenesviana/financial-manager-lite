// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  password  String
  name      String
  role      String           @default("USER") // "USER" ou "ADMIN"
  phone     String?          // Celular/WhatsApp do usuário
  expenses  Expense[]
  people       Person[]         @relation("CreatedPeople")
  linkedPeople Person[]         @relation("LinkedPeople")
  rules     AssignmentRule[]
  createdAt DateTime         @default(now())
}

model Person {
  id             String           @id @default(cuid())
  name           String
  phone          String?          // WhatsApp do integrante (ex: "5511999999999")
  expenses       Expense[]
  rules          AssignmentRule[]
  userId         String
  user           User             @relation("CreatedPeople", fields: [userId], references: [id], onDelete: Cascade)
  linkedUserId   String?
  linkedUser     User?            @relation("LinkedPeople", fields: [linkedUserId], references: [id], onDelete: SetNull)
  linkStatus     String           @default("NONE") // "NONE", "PENDING", "ACCEPTED", "REJECTED"
  inviteEmail    String?          // E-mail convidado
  createdAt      DateTime         @default(now())
}

model AssignmentRule {
  id        String   @id @default(cuid())
  keyword   String
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, keyword])
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  description String
  amount      Float
  person      Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId    String?
  card        String?
  isManual    Boolean   @default(false)
  month       String    @default("")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
}

