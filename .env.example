# ============================================================
# VARIÁVEIS DE AMBIENTE — Financial Manager Lite
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o arquivo .env com valores reais.
# ============================================================

# Conexão com o banco de dados PostgreSQL (Neon, Supabase, etc.)
# Exemplo: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Chave secreta para assinar os tokens JWT de sessão.
# Gere um valor seguro com: openssl rand -base64 64
# OBRIGATÓRIO — a aplicação não inicia sem esta variável.
JWT_SECRET="sua-chave-secreta-muito-longa-e-aleatoria-aqui"

# Chave da API do Google AI Studio para o interpretador de faturas PDF.
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY="sua-chave-gemini-aqui"

# Google OAuth2 para Login SSO
# Obtenha no console do Google Cloud: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sua-google-client-secret"

# URL base da aplicação para construir os redirecionamentos do callback
# Desenvolvimento local: http://localhost:3000
# Produção: https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

